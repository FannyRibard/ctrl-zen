{
  // Ctrl+Zen — un seul Worker Cloudflare : interface (fichiers statiques), API, base D1 et envoi programmé.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctrl-zen",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ctrl-zen-db",
      // Remplacé par le vrai identifiant après « wrangler d1 create ctrl-zen-db » (voir README).
      "database_id": "d2f26d62-32e4-4b37-b4df-a8e795b41b76",
      "migrations_dir": "migrations"
    }
  ],
  // Toutes les minutes : on regarde quelles notifs doivent partir.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
