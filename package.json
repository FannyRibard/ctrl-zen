{
  "name": "ctrl-zen",
  "private": true,
  "version": "1.0.0",
  "description": "Ctrl+Zen — webapp iPhone de rappels doux et de citations, avec notifications push.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "worker:dev": "npm run build && wrangler dev --test-scheduled",
    "db:local": "wrangler d1 migrations apply ctrl-zen-db --local",
    "db:remote": "wrangler d1 migrations apply ctrl-zen-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "vapid": "node scripts/gen-vapid.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.1.0",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@fontsource/dm-sans": "^5.1.0",
    "@preact/preset-vite": "^2.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "http_ece": "^1.2.1",
    "opentype.js": "^1.3.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
